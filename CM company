function trackAppUseFirebase(appId,authorPhone,price,saleType){
  let adValue=50; let saleValue=(saleType==="sale"?price:0); let total=adValue+saleValue;
  let creator20=Math.floor(total*0.20); let owner80=total-creator20;
  let statsKey=getAppStatsKey(appId);
  let stats={views:0,totalGenerated:0,creatorEarned:0,ownerEarned:0};
  try{stats=JSON.parse(localStorage.getItem(statsKey)||"{}");}catch{}
  stats.views=(stats.views||0)+1; stats.totalGenerated=(stats.totalGenerated||0)+total;
  stats.creatorEarned=(stats.creatorEarned||0)+creator20; stats.ownerEarned=(stats.ownerEarned||0)+owner80;
  localStorage.setItem(statsKey,JSON.stringify(stats));
  let earnKey=getEarningsKey(authorPhone);
  let earn={views:0,creatorAmount:0,ownerAmount:0,total:0};
  try{earn=JSON.parse(localStorage.getItem(earnKey)||"{}");}catch{}
  earn.views=(earn.views||0)+1; earn.creatorAmount=(earn.creatorAmount||0)+creator20;
  earn.ownerAmount=(earn.ownerAmount||0)+owner80; earn.total=(earn.total||0)+total;
  localStorage.setItem(earnKey,JSON.stringify(earn));
  let appStatsRef=db.ref("cm_app_stats/"+appId);
  appStatsRef.transaction(cur=>{
    if(cur===null) return {views:1,totalGenerated:total,creatorEarned:creator20,ownerEarned:owner80};
    cur.views=(cur.views||0)+1; cur.totalGenerated=(cur.totalGenerated||0)+total;
    cur.creatorEarned=(cur.creatorEarned||0)+creator20; cur.ownerEarned=(cur.ownerEarned||0)+owner80;
    return cur;
  });
  let earnRef=db.ref("cm_earnings/"+btoa(authorPhone));
  earnRef.transaction(cur=>{
    if(cur===null) return {views:1,creatorAmount:creator20,ownerAmount:owner80,total:total,phone:authorPhone};
    cur.views=(cur.views||0)+1; cur.creatorAmount=(cur.creatorAmount||0)+creator20;
    cur.ownerAmount=(cur.ownerAmount||0)+owner80; cur.total=(cur.total||0)+total;
    return cur;
  });
  let ownerRef=db.ref("cm_earnings/"+btoa("09158695308"));
  if(authorPhone!=="09158695308"){
    ownerRef.transaction(cur=>{
      if(cur===null) return {views:1,ownerAmount:owner80,total:total,phone:"09158695308"};
      cur.views=(cur.views||0)+1; cur.ownerAmount=(cur.ownerAmount||0)+owner80; cur.total=(cur.total||0)+total;
      return cur;
    });
  }
  db.ref("cm_usage_logs").push({appId:appId,authorPhone:authorPhone,userPhone:currentUser.phone,price:price,saleType:saleType,total:total,creator20:creator20,owner80:owner80,time:Date.now()});
  return {creator20,owner80,total,views:stats.views};
}
